# =============================================================================
# RAG Classroom — environment variables
# Copy this file to `.env` and fill in the values before running
#   docker compose up --build
# =============================================================================

# ------- API keys -------------------------------------------------------------

# DeepInfra key — used to compute BGE-M3 dense embeddings.
# Sign up at https://deepinfra.com and generate a key in the dashboard.
DEEPINFRA_API_KEY=

# Google Gemini key — used for both no-RAG and RAG answers.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------- Models (optional overrides) ------------------------------------------

GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-m3-multi

# ------- Admin auth -----------------------------------------------------------

# Password for the /admin page in the UI. Change this before class.
ADMIN_PASSWORD=changeme

# Used to sign admin JWT tokens. Set to any long random string.
JWT_SECRET=replace-me-with-a-long-random-string
